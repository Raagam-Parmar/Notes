<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Noted.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noted"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Noted.ViewModels"
    xmlns:converters="using:Noted.Converters"
    mc:Ignorable="d"
    Title="Noted">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <converters:NullToVisibilityConverter
                x:Key="NullToVisibilityConverter" />
            <converters:BoolToVisibilityConverter
                x:Key="BoolToVisibilityConverter" />
            <converters:TitleToDisplayTitleConverter
                x:Key="TitleToDisplayTitleConverter" />
            <converters:TitleToFontStyleConverter
                x:Key="TitleToFontStyleConverter" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Button Content="New Note"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Click="NewNoteButton_Click"/>

            <!-- Notes List Panel -->
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind NoteList.Notes}"
                      SelectedItem="{x:Bind NoteList.SelectedNote, Mode=TwoWay}">
                <!-- Template to view a SingleNote -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SingleNote">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Note title -->
                            <TextBlock Text="{Binding Title, Mode=OneWay, Converter={StaticResource TitleToDisplayTitleConverter}}"
                                       FontStyle="{Binding Title, Mode=OneWay, Converter={StaticResource TitleToFontStyleConverter}}"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"/>
                            
                            <!-- Delete button -->
                            <Button Content="Delete"
                                    Click="DeleteNoteButton_Click"
                                    HorizontalAlignment="Right"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="2"
                       Text="No Notes"
                       Visibility="{Binding NoteList.HasNoNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>


        <Grid Grid.Column="1"
              Visibility="{Binding NoteList.SelectedNote, Converter={StaticResource NullToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Text="{x:Bind NoteList.SelectedNote.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Name="Title"
                     PlaceholderText="Title"
                     Grid.Row="0"/>

            <TextBox Text="{x:Bind NoteList.SelectedNote.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Name="Body"
                     PlaceholderText="Body"
                     Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
