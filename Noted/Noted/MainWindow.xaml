<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Noted.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noted"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Noted.ViewModels"
    xmlns:converters="using:Noted.Converters"
    mc:Ignorable="d"
    Title="Noted">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <converters:NullToVisibilityConverter
                x:Key="NullToVisibilityConverter" />
            <converters:BoolToVisibilityConverter
                x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Button Content="New Note"
                    Grid.Row="0"
                    HorizontalAlignment="Center"/>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind NoteList.Notes}"
                      SelectedItem="{x:Bind NoteList.SelectedNote, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SingleNote">
                        <TextBlock Text="{x:Bind Title}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="2"
                       Text="No Notes"
                       Visibility="{Binding NoteList.HasNoNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>


        <Grid Grid.Column="1"
              Visibility="{Binding NoteList.SelectedNote, Converter={StaticResource NullToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Text="{x:Bind NoteList.SelectedNote.Title, Mode=TwoWay}"
                     Name="Title"
                     PlaceholderText="Title"
                     Grid.Row="0"/>
            
            <TextBox Text="{x:Bind NoteList.SelectedNote.Body, Mode=TwoWay}"
                     Name="Body"
                     PlaceholderText="Body"
                     Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
